# wrapper for long ipmipower commands

hosts=$2

check_hosts () {
  for i in $(nodeset -e $hosts); do squeue -w $i; done
}

while test $# -gt 0; do
  case "$1" in
    -h)
      echo "-h	show brief help"
      echo "-s	power stat"
      echo "-c	power cycle"
      echo "-d 	power off"
      echo "-u	power on"
      exit 0
    ;;
    -s)
      ipmipower -D lanplus -u root -p calvin -h $2.bmc --stat
      #ipmipower -D lanplus -u root -p calvin -h $2 --stat
      exit 0
    ;;
    -c)
      check_hosts
      echo press [Enter] to power cycle
      read ANS
      ipmipower -D lanplus -u root -p calvin -h $2.bmc --cycle
      #ipmipower -D lanplus -u root -p calvin -h $2 --cycle
      exit 0
    ;;
    -d)
      ipmipower -D lanplus -u root -p calvin -h $2.bmc --off
      #ipmipower -D lanplus -u root -p calvin -h $2 --off
      exit 0
    ;;
    -u)
      ipmipower -D lanplus -u root -p calvin -h $2.bmc --on
      #ipmipower -D lanplus -u root -p calvin -h $2 --on
      exit 0
    ;;
    *)
      echo "You have entered an invalid flag, use -h for help"
      exit 0
    ;;
  esac
done

while test $# -eq 0; do
  echo "You have not passed in a flag, use -h for help"
  exit 0
done
